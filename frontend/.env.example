# ที่อยู่ของ Go backend (ใช้ทั้งตอน proxy และตอน Server Component ดึงข้อมูล)
BACKEND_URL=http://localhost:8080

# Keycloak realm ที่ใช้ login (ต้อง reachable ทั้งจาก browser และจากฝั่ง server)
KEYCLOAK_ISSUER=http://localhost:8081/realms/tablebook
KEYCLOAK_CLIENT_ID=tablebook-web

# ตั้งเป็น true เมื่อรันบน HTTPS จริง (cookie จะถูกส่งเฉพาะ HTTPS)
COOKIE_SECURE=false
